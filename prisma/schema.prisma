generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleRights RoleRight[]
  users      User[]

  @@map("roles")
}

model RoleRight {
  id      String  @id @default(uuid())
  roleId  String  @map("role_id")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String
  action  String
  allowed Boolean @default(false)

  @@unique([roleId, module, action])
  @@map("role_rights")
}

model Store {
  id                String     @id @default(uuid())
  name              String
  address           String
  taxRegionId       String?    @map("tax_region_id")
  taxRegion         TaxRegion? @relation(fields: [taxRegionId], references: [id])
  timezone          String     @default("Asia/Kolkata")
  defaultCurrency   String     @default("INR") @map("default_currency")
  gstin             String?
  logoUrl           String?    @map("logo_url")
  receiptHeaderText String?    @map("receipt_header_text")
  receiptFooterText String?    @map("receipt_footer_text")
  returnPolicyText  String?    @map("return_policy_text")
  isActive          Boolean    @default(true) @map("is_active")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  users           User[]
  numberingSeries NumberingSeries[]
  auditLogs       AuditLog[]
  warehouses      Warehouse[]
  terminals       Terminal[]
  priceLists      PriceList[]
  loyaltyRules    LoyaltyRule[]
  apiCredentials  ApiCredential[]

  @@map("stores")
}

model FinancialYear {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  numberingSeries NumberingSeries[]

  @@map("financial_years")
}

enum SeriesType {
  cash_bill
  credit_bill
  stock_inward
  expiry_extension
  credit_note
  stock_damage
  stock_block
  stock_transfer
  positive_adjustment
  negative_adjustment
  opening_balance
  entry_correction
  payment_request
  refund
  bill_cancellation
  bill_return
  bill_payment
  shift
  online_bill
  stock_retest
  product_request
}

model NumberingSeries {
  id              String        @id @default(uuid())
  seriesType      SeriesType    @map("series_type")
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  prefix          String?
  currentNumber   Int           @default(0) @map("current_number")
  isActive        Boolean       @default(true) @map("is_active")
  isDeleted       Boolean       @default(false) @map("is_deleted")

  @@unique([seriesType, storeId, financialYearId])
  @@map("numbering_series")
}

enum MfaMethod {
  totp
  email_otp
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  storeId      String?    @map("store_id")
  store        Store?     @relation(fields: [storeId], references: [id])
  mfaMethod    MfaMethod? @map("mfa_method")
  isActive     Boolean    @default(true) @map("is_active")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  auditLogs          AuditLog[]
  apiCredentials     ApiCredential[]
  mfaDevices         MfaDevice[]
  emailOtpChallenges EmailOtpChallenge[]

  @@map("users")
}

model MfaDevice {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  secret     String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("mfa_devices")
}

model EmailOtpChallenge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_otp_challenges")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  storeId    String?  @map("store_id")
  store      Store?   @relation(fields: [storeId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([storeId])
  @@map("audit_logs")
}

model TaxRegion {
  id          String @id @default(uuid())
  countryCode String @map("country_code")
  name        String

  schemes TaxScheme[]
  stores  Store[]

  @@map("tax_regions")
}

model TaxScheme {
  id        String    @id @default(uuid())
  regionId  String    @map("region_id")
  region    TaxRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")

  components TaxComponent[]
  codes      TaxCode[]

  @@map("tax_schemes")
}

model TaxComponent {
  id            String    @id @default(uuid())
  schemeId      String    @map("scheme_id")
  scheme        TaxScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  name          String
  ratePercent   Decimal   @map("rate_percent") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  @@map("tax_components")
}

model TaxCode {
  id             String    @id @default(uuid())
  schemeId       String    @map("scheme_id")
  scheme         TaxScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  code           String
  description    String
  componentGroup String    @map("component_group")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")

  products Product[]

  @@unique([schemeId, code])
  @@map("tax_codes")
}

model Category {
  id               String     @id @default(uuid())
  name             String
  parentCategoryId String?    @map("parent_category_id")
  parent           Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  isActive         Boolean    @default(true) @map("is_active")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  createdAt        DateTime   @default(now()) @map("created_at")

  products  Product[]
  discounts Discount[]

  @@map("categories")
}

model Uom {
  id               String    @id @default(uuid())
  name             String
  abbreviation     String
  baseUomId        String?   @map("base_uom_id")
  baseUom          Uom?      @relation("UomConversion", fields: [baseUomId], references: [id])
  derivedUoms      Uom[]     @relation("UomConversion")
  conversionFactor Decimal?  @map("conversion_factor") @db.Decimal(12, 4)
  products         Product[]

  @@map("uoms")
}

model Product {
  id               String    @id @default(uuid())
  name             String
  categoryId       String?   @map("category_id")
  category         Category? @relation(fields: [categoryId], references: [id])
  taxCodeId        String    @map("tax_code_id")
  taxCode          TaxCode   @relation(fields: [taxCodeId], references: [id])
  trackExpiry      Boolean   @default(false) @map("track_expiry")
  images           String[]
  videos           String[]  @map("videos")
  description      String?
  packSize         Decimal?  @map("pack_size") @db.Decimal(10, 3)
  uomId            String    @map("uom_id")
  uom              Uom       @relation(fields: [uomId], references: [id])
  skuBarcode       String?   @unique @map("sku_barcode")
  systemBarcode    String    @unique @map("system_barcode")
  price            Decimal   @db.Decimal(12, 2)
  stockTracked     Boolean   @default(true) @map("stock_tracked")
  reorderLevel     Int?      @map("reorder_level")
  defaultCostPrice Decimal?  @map("default_cost_price") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  suppliers           Supplier[]
  discounts           Discount[]
  priceListItems      PriceListItem[]
  pendingMediaUploads PendingMediaUpload[]

  @@map("products")
}

// A live row here means that image/video is still being merged/stored/
// attached in the background (see /api/uploads/[id]/complete). Any device
// or session can query this for a given product, so "still processing" is
// visible everywhere, not just in the browser tab that started the
// upload. The row is deleted once the attach finishes (success or not).
model PendingMediaUpload {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  field     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_media_uploads")
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String
  email         String?
  taxId         String?  @map("tax_id")
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(12, 2)
  loyaltyPoints Int?     @map("loyalty_points")
  isActive      Boolean  @default(true) @map("is_active")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  taxId        String?  @map("tax_id")
  paymentTerms String?  @map("payment_terms")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("suppliers")
}

model Warehouse {
  id        String  @id @default(uuid())
  name      String
  address   String
  storeId   String? @map("store_id")
  store     Store?  @relation(fields: [storeId], references: [id])
  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  @@map("warehouses")
}

enum PaymentMethodType {
  cash
  card
  upi
  digital_wallet
  bank_transfer
  other
}

model PaymentMethod {
  id                String            @id @default(uuid())
  name              String
  type              PaymentMethodType
  requiresReference Boolean           @default(false) @map("requires_reference")
  isActive          Boolean           @default(true) @map("is_active")
  isDeleted         Boolean           @default(false) @map("is_deleted")

  @@map("payment_methods")
}

model PriceList {
  id            String    @id @default(uuid())
  name          String
  storeId       String?   @map("store_id")
  store         Store?    @relation(fields: [storeId], references: [id])
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String    @map("price_list_id")
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

enum DiscountType {
  percent
  flat
}

enum DiscountAppliesTo {
  product
  category
  all
}

model Discount {
  id            String            @id @default(uuid())
  name          String
  type          DiscountType
  value         Decimal           @db.Decimal(12, 2)
  appliesTo     DiscountAppliesTo @map("applies_to")
  productId     String?           @map("product_id")
  product       Product?          @relation(fields: [productId], references: [id])
  categoryId    String?           @map("category_id")
  category      Category?         @relation(fields: [categoryId], references: [id])
  couponCode    String?           @unique @map("coupon_code")
  effectiveFrom DateTime?         @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  isActive      Boolean           @default(true) @map("is_active")
  isDeleted     Boolean           @default(false) @map("is_deleted")

  @@map("discounts")
}

model Terminal {
  id               String  @id @default(uuid())
  storeId          String  @map("store_id")
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  deviceIdentifier String? @map("device_identifier")
  isActive         Boolean @default(true) @map("is_active")
  isDeleted        Boolean @default(false) @map("is_deleted")

  @@map("terminals")
}

enum ReasonCodeCategory {
  return
  void
  discount
  stock_adjustment
  damage
  stock_block
}

model ReasonCode {
  id        String             @id @default(uuid())
  category  ReasonCodeCategory
  label     String
  isActive  Boolean            @default(true) @map("is_active")
  isDeleted Boolean            @default(false) @map("is_deleted")

  @@map("reason_codes")
}

enum DenominationType {
  note
  coin
}

model CashDenomination {
  id        String           @id @default(uuid())
  value     Decimal          @db.Decimal(12, 2)
  type      DenominationType
  currency  String
  isActive  Boolean          @default(true) @map("is_active")
  isDeleted Boolean          @default(false) @map("is_deleted")

  @@map("cash_denominations")
}

model LoyaltyRule {
  id              String    @id @default(uuid())
  storeId         String?   @map("store_id")
  store           Store?    @relation(fields: [storeId], references: [id])
  earnRate        Decimal   @map("earn_rate") @db.Decimal(12, 4)
  redeemRate      Decimal   @map("redeem_rate") @db.Decimal(12, 4)
  minRedeemPoints Int?      @map("min_redeem_points")
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")

  @@map("loyalty_rules")
}

model ApiCredential {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label           String
  apiKey          String    @unique @map("api_key")
  apiSecretHash   String    @map("api_secret_hash")
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdByUserId String    @map("created_by_user_id")
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")

  @@map("api_credentials")
}
