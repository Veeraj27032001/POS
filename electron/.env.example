# Copy to .env for local dev (this file itself is git-ignored, only
# .env.example is committed). SERVER_URL's real default — no .env needed —
# is the production app, https://pos.vedixsolutions.com; a packaged
# installer ships with no .env at all and picks that up automatically.
# Uncomment the line below only for local development against `pnpm dev`
# in the repo root. A specific till can be repointed after install via
# %APPDATA%/pos-electron/config.json instead of rebuilding or editing this
# file.

# SERVER_URL=http://localhost:3000
KIOSK_MODE=false

# none | network | windows | serial
PRINTER_TRANSPORT=none
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WINDOWS_NAME=
PRINTER_SERIAL_PATH=

# Printer used for kind:"html" jobs (full bill/credit-note/refund formats).
# Leave unset to use the OS default printer.
DOCUMENT_PRINTER_NAME=
