generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleRights RoleRight[]
  users      User[]

  @@map("roles")
}

model RoleRight {
  id      String  @id @default(uuid())
  roleId  String  @map("role_id")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String
  action  String
  allowed Boolean @default(false)

  @@unique([roleId, module, action])
  @@map("role_rights")
}

model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  callingCode String   @map("calling_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  states     State[]
  stores     Store[]
  warehouses Warehouse[]
  customers  Customer[]
  suppliers  Supplier[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid())
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  stores     Store[]
  warehouses Warehouse[]
  customers  Customer[]
  suppliers  Supplier[]

  @@unique([countryId, code])
  @@map("states")
}

model Currency {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  stores            Store[]
  cashDenominations CashDenomination[]

  @@map("currencies")
}

model Timezone {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  stores Store[]

  @@map("timezones")
}

model Store {
  id                String     @id @default(uuid())
  name              String
  address           String
  countryId         String?    @map("country_id")
  country           Country?   @relation(fields: [countryId], references: [id])
  stateId           String?    @map("state_id")
  state             State?     @relation(fields: [stateId], references: [id])
  taxEngineId       String?    @map("tax_engine_id")
  taxEngine         TaxEngine? @relation(fields: [taxEngineId], references: [id])
  timezoneId        String?    @map("timezone_id")
  storeTimezone     Timezone?  @relation(fields: [timezoneId], references: [id])
  currencyId        String?    @map("currency_id")
  currency          Currency?  @relation(fields: [currencyId], references: [id])
  gstin             String?
  logoUrl           String?    @map("logo_url")
  receiptHeaderText String?    @map("receipt_header_text")
  receiptFooterText String?    @map("receipt_footer_text")
  returnPolicyText  String?    @map("return_policy_text")
  isActive          Boolean    @default(true) @map("is_active")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  users             User[]
  numberingSeries   NumberingSeries[]
  auditLogs         AuditLog[]
  warehouses        Warehouse[]
  terminals         Terminal[]
  priceLists        PriceList[]
  loyaltyRules      LoyaltyRule[]
  apiCredentials    ApiCredential[]
  customers         Customer[]
  suppliers         Supplier[]
  cashDenominations CashDenomination[]

  stockInwardMains             StockInwardMain[]
  stockDamageMains             StockDamageMain[]
  stockBlockMains              StockBlockMain[]
  stockTransferMains           StockTransferMain[]
  stockTransfersAsDestination  StockTransferMain[]           @relation("StockTransferDestinationStore")
  stockPositiveAdjustmentMains StockPositiveAdjustmentMain[]
  stockOpeningMains            StockOpeningMain[]
  stockNegativeAdjustmentMains StockNegativeAdjustmentMain[]
  stockQualityCheckMains       StockQualityCheckMain[]
  productRequestMains          ProductRequestMain[]
  stockEntryCorrections        StockEntryCorrection[]

  @@map("stores")
}

model FinancialYear {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  numberingSeries NumberingSeries[]

  stockInwardMains             StockInwardMain[]
  stockDamageMains             StockDamageMain[]
  stockBlockMains              StockBlockMain[]
  stockTransferMains           StockTransferMain[]
  stockPositiveAdjustmentMains StockPositiveAdjustmentMain[]
  stockOpeningMains            StockOpeningMain[]
  stockNegativeAdjustmentMains StockNegativeAdjustmentMain[]
  stockQualityCheckMains       StockQualityCheckMain[]
  productRequestMains          ProductRequestMain[]
  stockEntryCorrections        StockEntryCorrection[]

  @@map("financial_years")
}

enum SeriesType {
  cash_bill
  credit_bill
  stock_inward
  credit_note
  stock_damage
  stock_block
  stock_transfer
  positive_adjustment
  negative_adjustment
  opening_balance
  entry_correction
  payment_request
  refund
  bill_cancellation
  bill_return
  bill_payment
  shift
  online_bill
  quality_check
  product_request
}

model NumberingSeries {
  id              String        @id @default(uuid())
  seriesType      SeriesType    @map("series_type")
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  prefix          String?
  currentNumber   Int           @default(0) @map("current_number")
  isActive        Boolean       @default(true) @map("is_active")
  isDeleted       Boolean       @default(false) @map("is_deleted")

  @@unique([seriesType, storeId, financialYearId])
  @@map("numbering_series")
}

enum MfaMethod {
  totp
  email_otp
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  storeId      String?    @map("store_id")
  store        Store?     @relation(fields: [storeId], references: [id])
  mfaMethod    MfaMethod? @map("mfa_method")
  isActive     Boolean    @default(true) @map("is_active")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  auditLogs          AuditLog[]
  apiCredentials     ApiCredential[]
  mfaDevices         MfaDevice[]
  emailOtpChallenges EmailOtpChallenge[]

  stockInwardMains             StockInwardMain[]
  stockDamageMains             StockDamageMain[]
  stockBlockMains              StockBlockMain[]
  stockPositiveAdjustmentMains StockPositiveAdjustmentMain[]
  stockOpeningMains            StockOpeningMain[]
  stockNegativeAdjustmentMains StockNegativeAdjustmentMain[]
  stockQualityCheckMains       StockQualityCheckMain[]
  productRequestMains          ProductRequestMain[]
  stockEntryCorrections        StockEntryCorrection[]
  productSupplierPrices        ProductSupplierPrice[]
  productPriceHistory          ProductPriceHistory[]

  stockBlockReleases      StockBlockItem[]    @relation("StockBlockReleasedBy")
  stockTransfersRequested StockTransferMain[] @relation("StockTransferRequestedBy")
  stockTransfersResponded StockTransferMain[] @relation("StockTransferRespondedBy")

  @@map("users")
}

model MfaDevice {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  secret     String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("mfa_devices")
}

model EmailOtpChallenge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_otp_challenges")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  storeId    String?  @map("store_id")
  store      Store?   @relation(fields: [storeId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([storeId])
  @@map("audit_logs")
}

enum StockBlockSourceType {
  manual
  pending_transfer
  draft_bill_line
  ecommerce_order
}

enum StockBlockItemStatus {
  active
  released
}

enum StockTransferStatus {
  pending
  accepted
  rejected
  cancelled
}

enum StockCorrectionSourceType {
  stock_inward_item
  stock_damage_item
  stock_positive_adjustment_item
  stock_negative_adjustment_item
  stock_opening_item
}

enum ProductRequestStatus {
  draft
  sent
  partially_received
  received
  cancelled
}

model StockInwardMain {
  id              String              @id @default(uuid())
  documentNumber  String              @map("document_number")
  financialYearId String              @map("financial_year_id")
  financialYear   FinancialYear       @relation(fields: [financialYearId], references: [id])
  storeId         String              @map("store_id")
  store           Store               @relation(fields: [storeId], references: [id])
  warehouseId     String              @map("warehouse_id")
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  supplierId      String?             @map("supplier_id")
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?             @map("purchase_order_id")
  purchaseOrder   ProductRequestMain? @relation(fields: [purchaseOrderId], references: [id])
  inwardDate      DateTime            @map("inward_date") @db.Date
  notes           String?
  createdByUserId String              @map("created_by_user_id")
  createdByUser   User                @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")

  items StockInwardItem[]

  @@map("stock_inward_mains")
}

model StockInwardItem {
  id                String          @id @default(uuid())
  stockInwardMainId String          @map("stock_inward_main_id")
  stockInwardMain   StockInwardMain @relation(fields: [stockInwardMainId], references: [id], onDelete: Cascade)
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  productName       String          @map("product_name")
  productBarcode    String          @map("product_barcode")
  productPrice      Decimal         @map("product_price") @db.Decimal(12, 2)
  productHsnCode    String?         @map("product_hsn_code")
  quantityAccepted  Int             @map("quantity_accepted")
  quantityRejected  Int?            @map("quantity_rejected")
  unitCost          Decimal?        @map("unit_cost") @db.Decimal(12, 2)

  @@map("stock_inward_items")
}

model StockDamageMain {
  id              String        @id @default(uuid())
  documentNumber  String        @map("document_number")
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  warehouseId     String        @map("warehouse_id")
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items StockDamageItem[]

  @@map("stock_damage_mains")
}

model StockDamageItem {
  id                String          @id @default(uuid())
  stockDamageMainId String          @map("stock_damage_main_id")
  stockDamageMain   StockDamageMain @relation(fields: [stockDamageMainId], references: [id], onDelete: Cascade)
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  productName       String          @map("product_name")
  productBarcode    String          @map("product_barcode")
  productPrice      Decimal         @map("product_price") @db.Decimal(12, 2)
  productHsnCode    String?         @map("product_hsn_code")
  quantity          Int
  reasonCodeId      String          @map("reason_code_id")
  reasonCode        ReasonCode      @relation(fields: [reasonCodeId], references: [id])

  @@map("stock_damage_items")
}

model StockBlockMain {
  id              String               @id @default(uuid())
  documentNumber  String               @map("document_number")
  financialYearId String               @map("financial_year_id")
  financialYear   FinancialYear        @relation(fields: [financialYearId], references: [id])
  storeId         String               @map("store_id")
  store           Store                @relation(fields: [storeId], references: [id])
  warehouseId     String               @map("warehouse_id")
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  sourceType      StockBlockSourceType @default(manual) @map("source_type")
  sourceId        String?              @map("source_id")
  reviewByDate    DateTime?            @map("review_by_date") @db.Date
  blockedByUserId String               @map("blocked_by_user_id")
  blockedByUser   User                 @relation(fields: [blockedByUserId], references: [id])
  blockedAt       DateTime             @default(now()) @map("blocked_at")

  items StockBlockItem[]

  @@map("stock_block_mains")
}

model StockBlockItem {
  id               String               @id @default(uuid())
  stockBlockMainId String               @map("stock_block_main_id")
  stockBlockMain   StockBlockMain       @relation(fields: [stockBlockMainId], references: [id], onDelete: Cascade)
  productId        String               @map("product_id")
  product          Product              @relation(fields: [productId], references: [id])
  productName      String               @map("product_name")
  productBarcode   String               @map("product_barcode")
  productPrice     Decimal              @map("product_price") @db.Decimal(12, 2)
  productHsnCode   String?              @map("product_hsn_code")
  quantityBlocked  Int                  @map("quantity_blocked")
  reasonCodeId     String               @map("reason_code_id")
  reasonCode       ReasonCode           @relation(fields: [reasonCodeId], references: [id])
  status           StockBlockItemStatus @default(active)
  releasedByUserId String?              @map("released_by_user_id")
  releasedByUser   User?                @relation("StockBlockReleasedBy", fields: [releasedByUserId], references: [id])
  releasedAt       DateTime?            @map("released_at")

  @@map("stock_block_items")
}

model StockTransferMain {
  id                 String              @id @default(uuid())
  documentNumber     String              @map("document_number")
  financialYearId    String              @map("financial_year_id")
  financialYear      FinancialYear       @relation(fields: [financialYearId], references: [id])
  storeId            String              @map("store_id")
  store              Store               @relation(fields: [storeId], references: [id])
  sourceWarehouseId  String              @map("source_warehouse_id")
  sourceWarehouse    Warehouse           @relation("StockTransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationStoreId String              @map("destination_store_id")
  destinationStore   Store               @relation("StockTransferDestinationStore", fields: [destinationStoreId], references: [id])
  status             StockTransferStatus @default(pending)
  requestedByUserId  String              @map("requested_by_user_id")
  requestedByUser    User                @relation("StockTransferRequestedBy", fields: [requestedByUserId], references: [id])
  requestedAt        DateTime            @default(now()) @map("requested_at")
  respondedByUserId  String?             @map("responded_by_user_id")
  respondedByUser    User?               @relation("StockTransferRespondedBy", fields: [respondedByUserId], references: [id])
  respondedAt        DateTime?           @map("responded_at")
  receivedDate       DateTime?           @map("received_date") @db.Date
  cancelledAt        DateTime?           @map("cancelled_at")
  notes              String?

  items StockTransferItem[]

  @@map("stock_transfer_mains")
}

model StockTransferItem {
  id                     String            @id @default(uuid())
  stockTransferMainId    String            @map("stock_transfer_main_id")
  stockTransferMain      StockTransferMain @relation(fields: [stockTransferMainId], references: [id], onDelete: Cascade)
  productId              String            @map("product_id")
  product                Product           @relation(fields: [productId], references: [id])
  productName            String            @map("product_name")
  productBarcode         String            @map("product_barcode")
  productPrice           Decimal           @map("product_price") @db.Decimal(12, 2)
  productHsnCode         String?           @map("product_hsn_code")
  quantity               Int
  destinationWarehouseId String?           @map("destination_warehouse_id")
  destinationWarehouse   Warehouse?        @relation("StockTransferItemDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  quantityAccepted       Int?              @map("quantity_accepted")
  quantityRejected       Int?              @map("quantity_rejected")

  @@map("stock_transfer_items")
}

model StockPositiveAdjustmentMain {
  id              String        @id @default(uuid())
  documentNumber  String        @map("document_number")
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  warehouseId     String        @map("warehouse_id")
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items StockPositiveAdjustmentItem[]

  @@map("stock_positive_adjustment_mains")
}

model StockPositiveAdjustmentItem {
  id                            String                      @id @default(uuid())
  stockPositiveAdjustmentMainId String                      @map("stock_positive_adjustment_main_id")
  stockPositiveAdjustmentMain   StockPositiveAdjustmentMain @relation(fields: [stockPositiveAdjustmentMainId], references: [id], onDelete: Cascade)
  productId                     String                      @map("product_id")
  product                       Product                     @relation(fields: [productId], references: [id])
  productName                   String                      @map("product_name")
  productBarcode                String                      @map("product_barcode")
  productPrice                  Decimal                     @map("product_price") @db.Decimal(12, 2)
  productHsnCode                String?                     @map("product_hsn_code")
  quantity                      Int
  reasonCodeId                  String                      @map("reason_code_id")
  reasonCode                    ReasonCode                  @relation(fields: [reasonCodeId], references: [id])

  @@map("stock_positive_adjustment_items")
}

model StockOpeningMain {
  id              String        @id @default(uuid())
  documentNumber  String        @map("document_number")
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  warehouseId     String        @map("warehouse_id")
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items StockOpeningItem[]

  @@map("stock_opening_mains")
}

model StockOpeningItem {
  id                 String           @id @default(uuid())
  stockOpeningMainId String           @map("stock_opening_main_id")
  stockOpeningMain   StockOpeningMain @relation(fields: [stockOpeningMainId], references: [id], onDelete: Cascade)
  productId          String           @map("product_id")
  product            Product          @relation(fields: [productId], references: [id])
  productName        String           @map("product_name")
  productBarcode     String           @map("product_barcode")
  productPrice       Decimal          @map("product_price") @db.Decimal(12, 2)
  productHsnCode     String?          @map("product_hsn_code")
  quantity           Int

  @@map("stock_opening_items")
}

model StockNegativeAdjustmentMain {
  id              String        @id @default(uuid())
  documentNumber  String        @map("document_number")
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  warehouseId     String        @map("warehouse_id")
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items StockNegativeAdjustmentItem[]

  @@map("stock_negative_adjustment_mains")
}

model StockNegativeAdjustmentItem {
  id                            String                      @id @default(uuid())
  stockNegativeAdjustmentMainId String                      @map("stock_negative_adjustment_main_id")
  stockNegativeAdjustmentMain   StockNegativeAdjustmentMain @relation(fields: [stockNegativeAdjustmentMainId], references: [id], onDelete: Cascade)
  productId                     String                      @map("product_id")
  product                       Product                     @relation(fields: [productId], references: [id])
  productName                   String                      @map("product_name")
  productBarcode                String                      @map("product_barcode")
  productPrice                  Decimal                     @map("product_price") @db.Decimal(12, 2)
  productHsnCode                String?                     @map("product_hsn_code")
  quantity                      Int
  reasonCodeId                  String                      @map("reason_code_id")
  reasonCode                    ReasonCode                  @relation(fields: [reasonCodeId], references: [id])

  @@map("stock_negative_adjustment_items")
}

model StockEntryCorrection {
  id                String                    @id @default(uuid())
  documentNumber    String                    @map("document_number")
  financialYearId   String                    @map("financial_year_id")
  financialYear     FinancialYear             @relation(fields: [financialYearId], references: [id])
  storeId           String                    @map("store_id")
  store             Store                     @relation(fields: [storeId], references: [id])
  sourceItemType    StockCorrectionSourceType @map("source_item_type")
  sourceItemId      String                    @map("source_item_id")
  fieldCorrected    String                    @map("field_corrected")
  previousValue     Int                       @map("previous_value")
  newValue          Int                       @map("new_value")
  notes             String?
  correctedByUserId String                    @map("corrected_by_user_id")
  correctedByUser   User                      @relation(fields: [correctedByUserId], references: [id])
  correctedAt       DateTime                  @default(now()) @map("corrected_at")

  @@map("stock_entry_corrections")
}

model StockQualityCheckMain {
  id              String        @id @default(uuid())
  documentNumber  String        @map("document_number")
  financialYearId String        @map("financial_year_id")
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  warehouseId     String        @map("warehouse_id")
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  items StockQualityCheckItem[]

  @@map("stock_quality_check_mains")
}

model StockQualityCheckItem {
  id                      String                @id @default(uuid())
  stockQualityCheckMainId String                @map("stock_quality_check_main_id")
  stockQualityCheckMain   StockQualityCheckMain @relation(fields: [stockQualityCheckMainId], references: [id], onDelete: Cascade)
  productId               String                @map("product_id")
  product                 Product               @relation(fields: [productId], references: [id])
  productName             String                @map("product_name")
  productBarcode          String                @map("product_barcode")
  productPrice            Decimal               @map("product_price") @db.Decimal(12, 2)
  productHsnCode          String?               @map("product_hsn_code")
  quantity                Int
  reasonCodeId            String                @map("reason_code_id")
  reasonCode              ReasonCode            @relation(fields: [reasonCodeId], references: [id])

  @@map("stock_quality_check_items")
}

model ProductRequestMain {
  id              String               @id @default(uuid())
  documentNumber  String               @map("document_number")
  financialYearId String               @map("financial_year_id")
  financialYear   FinancialYear        @relation(fields: [financialYearId], references: [id])
  storeId         String               @map("store_id")
  store           Store                @relation(fields: [storeId], references: [id])
  supplierId      String               @map("supplier_id")
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  requestDate     DateTime             @map("request_date") @db.Date
  status          ProductRequestStatus @default(draft)
  createdByUserId String               @map("created_by_user_id")
  createdByUser   User                 @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime             @default(now()) @map("created_at")

  items          ProductRequestItem[]
  inwardReceipts StockInwardMain[]

  @@map("product_request_mains")
}

model ProductRequestItem {
  id                   String             @id @default(uuid())
  productRequestMainId String             @map("product_request_main_id")
  productRequestMain   ProductRequestMain @relation(fields: [productRequestMainId], references: [id], onDelete: Cascade)
  productId            String             @map("product_id")
  product              Product            @relation(fields: [productId], references: [id])
  productName          String             @map("product_name")
  productBarcode       String             @map("product_barcode")
  productPrice         Decimal            @map("product_price") @db.Decimal(12, 2)
  productHsnCode       String?            @map("product_hsn_code")
  quantityRequested    Int                @map("quantity_requested")
  quantityReceived     Int                @default(0) @map("quantity_received")
  expectedUnitCost     Decimal?           @map("expected_unit_cost") @db.Decimal(12, 2)

  @@map("product_request_items")
}

model TaxEngine {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  stores Store[]

  @@map("tax_engines")
}

model HsnCode {
  id          String  @id @default(uuid())
  hsnCode     String  @unique @map("hsn_code")
  description String
  cgstRate    Decimal @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate    Decimal @map("sgst_rate") @db.Decimal(5, 2)
  igstRate    Decimal @map("igst_rate") @db.Decimal(5, 2)
  isActive    Boolean @default(true) @map("is_active")
  isDeleted   Boolean @default(false) @map("is_deleted")

  products Product[]

  @@map("hsn_codes")
}

// Singleton — a single row of global, Super-Admin-only tax preferences.
model TaxPreferences {
  id                    String  @id @default(uuid())
  hsnTaxDisplayEnabled  Boolean @default(true) @map("hsn_tax_display_enabled")
  autoApplyTaxByDefault Boolean @default(true) @map("auto_apply_tax_by_default")

  @@map("tax_preferences")
}

model Category {
  id               String     @id @default(uuid())
  name             String
  parentCategoryId String?    @map("parent_category_id")
  parent           Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  isActive         Boolean    @default(true) @map("is_active")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  createdAt        DateTime   @default(now()) @map("created_at")

  products  Product[]
  discounts Discount[]

  @@map("categories")
}

model Uom {
  id               String    @id @default(uuid())
  name             String
  abbreviation     String
  baseUomId        String?   @map("base_uom_id")
  baseUom          Uom?      @relation("UomConversion", fields: [baseUomId], references: [id])
  derivedUoms      Uom[]     @relation("UomConversion")
  conversionFactor Decimal?  @map("conversion_factor") @db.Decimal(12, 4)
  products         Product[]

  @@map("uoms")
}

model Product {
  id               String    @id @default(uuid())
  name             String
  categoryId       String?   @map("category_id")
  category         Category? @relation(fields: [categoryId], references: [id])
  hsnCodeId        String?   @map("hsn_code_id")
  hsnCode          HsnCode?  @relation(fields: [hsnCodeId], references: [id])
  images           String[]
  videos           String[]  @map("videos")
  description      String?
  packSize         Decimal?  @map("pack_size") @db.Decimal(10, 3)
  uomId            String    @map("uom_id")
  uom              Uom       @relation(fields: [uomId], references: [id])
  skuBarcode       String?   @unique @map("sku_barcode")
  systemBarcode    String    @unique @map("system_barcode")
  price            Decimal   @db.Decimal(12, 2)
  stockTracked     Boolean   @default(true) @map("stock_tracked")
  reorderLevel     Int?      @map("reorder_level")
  defaultCostPrice Decimal?  @map("default_cost_price") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  suppliers           Supplier[]
  discounts           Discount[]
  priceListItems      PriceListItem[]
  pendingMediaUploads PendingMediaUpload[]

  stockInwardItems             StockInwardItem[]
  stockDamageItems             StockDamageItem[]
  stockBlockItems              StockBlockItem[]
  stockTransferItems           StockTransferItem[]
  stockPositiveAdjustmentItems StockPositiveAdjustmentItem[]
  stockOpeningItems            StockOpeningItem[]
  stockNegativeAdjustmentItems StockNegativeAdjustmentItem[]
  stockQualityCheckItems       StockQualityCheckItem[]
  productRequestItems          ProductRequestItem[]
  supplierPrices               ProductSupplierPrice[]
  priceHistory                 ProductPriceHistory[]

  @@map("products")
}

// Append-only: each row is one priced quote from a supplier for a product.
// The current cost for a (product, supplier) pair is simply its most recent
// row — this is what gives history "for free" without a separate log table.
model ProductSupplierPrice {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId      String   @map("supplier_id")
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  cost            Decimal  @db.Decimal(12, 2)
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("product_supplier_prices")
}

// Append-only log written whenever Product.price (the selling price)
// changes — Product.price itself stays the current value everywhere else.
model ProductPriceHistory {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price           Decimal  @db.Decimal(12, 2)
  changedByUserId String   @map("changed_by_user_id")
  changedByUser   User     @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime @default(now()) @map("changed_at")

  @@map("product_price_history")
}

// A live row here means that image/video is still being merged/stored/
// attached in the background (see /api/uploads/[id]/complete). Any device
// or session can query this for a given product, so "still processing" is
// visible everywhere, not just in the browser tab that started the
// upload. The row is deleted once the attach finishes (success or not).
model PendingMediaUpload {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  field     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_media_uploads")
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String
  email         String?
  address       String?
  countryId     String?  @map("country_id")
  country       Country? @relation(fields: [countryId], references: [id])
  stateId       String?  @map("state_id")
  state         State?   @relation(fields: [stateId], references: [id])
  taxId         String?  @map("tax_id")
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(12, 2)
  loyaltyPoints Int?     @map("loyalty_points")
  isActive      Boolean  @default(true) @map("is_active")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stores Store[]

  @@map("customers")
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  address      String?
  countryId    String?  @map("country_id")
  country      Country? @relation(fields: [countryId], references: [id])
  stateId      String?  @map("state_id")
  state        State?   @relation(fields: [stateId], references: [id])
  taxId        String?  @map("tax_id")
  paymentTerms String?  @map("payment_terms")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]
  stores   Store[]

  stockInwardMains    StockInwardMain[]
  productRequestMains ProductRequestMain[]
  supplierPrices      ProductSupplierPrice[]

  @@map("suppliers")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String
  countryId String?  @map("country_id")
  country   Country? @relation(fields: [countryId], references: [id])
  stateId   String?  @map("state_id")
  state     State?   @relation(fields: [stateId], references: [id])
  storeId   String?  @map("store_id")
  store     Store?   @relation(fields: [storeId], references: [id])
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")

  stockInwardMains              StockInwardMain[]
  stockDamageMains              StockDamageMain[]
  stockBlockMains               StockBlockMain[]
  stockTransfersAsSource        StockTransferMain[]           @relation("StockTransferSourceWarehouse")
  stockTransferItemDestinations StockTransferItem[]           @relation("StockTransferItemDestinationWarehouse")
  stockPositiveAdjustmentMains  StockPositiveAdjustmentMain[]
  stockOpeningMains             StockOpeningMain[]
  stockNegativeAdjustmentMains  StockNegativeAdjustmentMain[]
  stockQualityCheckMains        StockQualityCheckMain[]

  @@map("warehouses")
}

enum PaymentMethodType {
  cash
  card
  upi
  digital_wallet
  bank_transfer
  other
}

model PaymentMethod {
  id                String            @id @default(uuid())
  name              String
  type              PaymentMethodType
  requiresReference Boolean           @default(false) @map("requires_reference")
  isActive          Boolean           @default(true) @map("is_active")
  isDeleted         Boolean           @default(false) @map("is_deleted")

  @@map("payment_methods")
}

model PriceList {
  id            String    @id @default(uuid())
  name          String
  storeId       String?   @map("store_id")
  store         Store?    @relation(fields: [storeId], references: [id])
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String    @map("price_list_id")
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

enum DiscountType {
  percent
  flat
}

enum DiscountAppliesTo {
  product
  category
  all
}

model Discount {
  id            String            @id @default(uuid())
  name          String
  type          DiscountType
  value         Decimal           @db.Decimal(12, 2)
  appliesTo     DiscountAppliesTo @map("applies_to")
  productId     String?           @map("product_id")
  product       Product?          @relation(fields: [productId], references: [id])
  categoryId    String?           @map("category_id")
  category      Category?         @relation(fields: [categoryId], references: [id])
  couponCode    String?           @unique @map("coupon_code")
  effectiveFrom DateTime?         @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  isActive      Boolean           @default(true) @map("is_active")
  isDeleted     Boolean           @default(false) @map("is_deleted")

  @@map("discounts")
}

model Terminal {
  id               String  @id @default(uuid())
  storeId          String  @map("store_id")
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  deviceIdentifier String? @map("device_identifier")
  isActive         Boolean @default(true) @map("is_active")
  isDeleted        Boolean @default(false) @map("is_deleted")

  @@map("terminals")
}

enum ReasonCodeCategory {
  return
  void
  discount
  stock_adjustment
  damage
  stock_block
  quality_check
}

model ReasonCode {
  id        String             @id @default(uuid())
  category  ReasonCodeCategory
  label     String
  isActive  Boolean            @default(true) @map("is_active")
  isDeleted Boolean            @default(false) @map("is_deleted")

  stockDamageItems             StockDamageItem[]
  stockBlockItems              StockBlockItem[]
  stockPositiveAdjustmentItems StockPositiveAdjustmentItem[]
  stockNegativeAdjustmentItems StockNegativeAdjustmentItem[]
  stockQualityCheckItems       StockQualityCheckItem[]

  @@map("reason_codes")
}

enum DenominationType {
  note
  coin
}

model CashDenomination {
  id         String           @id @default(uuid())
  value      Decimal          @db.Decimal(12, 2)
  type       DenominationType
  storeId    String           @map("store_id")
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currencyId String           @map("currency_id")
  currency   Currency         @relation(fields: [currencyId], references: [id])
  isActive   Boolean          @default(true) @map("is_active")
  isDeleted  Boolean          @default(false) @map("is_deleted")

  @@map("cash_denominations")
}

model LoyaltyRule {
  id              String    @id @default(uuid())
  storeId         String?   @map("store_id")
  store           Store?    @relation(fields: [storeId], references: [id])
  earnRate        Decimal   @map("earn_rate") @db.Decimal(12, 4)
  redeemRate      Decimal   @map("redeem_rate") @db.Decimal(12, 4)
  minRedeemPoints Int?      @map("min_redeem_points")
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")

  @@map("loyalty_rules")
}

model ApiCredential {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label           String
  apiKey          String    @unique @map("api_key")
  apiSecretHash   String    @map("api_secret_hash")
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdByUserId String    @map("created_by_user_id")
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")

  @@map("api_credentials")
}
