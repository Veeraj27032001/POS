# Copy to .env.local and fill in. Never commit .env.local.

# ── Database — Supabase Postgres (NJS-06) ────────────────────────────────────
# Supabase → Settings → Database → Connection string.
# Percent-encode special characters in the password ('$' -> %24, '@' -> %40).
#
# DATABASE_URL is what the app queries through; DIRECT_URL is what `prisma
# migrate` uses. They differ only when going through the connection pooler:
#   pooled  : postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   direct  : postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase project (NJS-34 storage/CDN, NJS-24 realtime) ───────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Auth.js (NJS-11) ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Demo admin seeded by prisma/seed.ts — also used by e2e tests to log in.
# Never hardcode real credentials in source; set these here instead.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional second account (Admin tier, not Super Admin) — only needed to run
# the e2e tests that verify Admin-specific RBAC behavior.
SEED_ADMIN2_EMAIL=""
SEED_ADMIN2_PASSWORD=""

# ── Adapter selection (see /lib/adapters) ────────────────────────────────────
# Swap one value to move from stub to real service; no feature code changes.
STORAGE_ADAPTER="local"      # local | supabase
PAYMENT_ADAPTER="stub"       # stub  | razorpay   (NJS-35)
DISABLE_PAYMENT_GATEWAY="false"  # true turns off QR/link/card-machine collection everywhere, regardless of store settings
NOTIFIER_ADAPTER="console"   # console | email-sms
SENTRY_ENABLED="false"       # NJS-31

# Supabase Storage — S3-compatible API, only needed when STORAGE_ADAPTER=supabase.
# SUPABASE_URL is the same project URL as NEXT_PUBLIC_SUPABASE_URL above.
# Access key/secret: Supabase → Settings → Storage → S3 Connection → New access key
# (server-only — never expose these with a NEXT_PUBLIC_ prefix).
# SUPABASE_S3_REGION is shown on that same S3 Connection page.
# The bucket must exist and be set to public before uploads will work.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_S3_REGION="us-east-1"
SUPABASE_STORAGE_BUCKET="product-media"

# Max total upload size (product images/video). Supabase free plan caps
# single-request storage uploads at 50 MB — keep this at or below that
# unless you're on a paid plan or move to resumable (TUS) uploads.
MAX_UPLOAD_FILE_SIZE_MB="50"

# Razorpay — only needed when PAYMENT_ADAPTER=razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP — only needed when NOTIFIER_ADAPTER=email-sms
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Application defaults (NJS-20 / NJS-21) ───────────────────────────────────
APP_DEFAULT_TIMEZONE="Asia/Kolkata"
APP_DEFAULT_CURRENCY="INR"
APP_DEFAULT_LOCALE="en-IN"

# ── Operational thresholds — "visible, not automatic" lists ──────────────────
STALE_BLOCK_DEFAULT_DAYS="7"     # step4 §3
STALE_HELD_BILL_HOURS="24"       # step5 §11
